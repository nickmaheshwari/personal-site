# Copy to .env for local dev (`npm run dev -w apps/i-need-a-job` reads it).
# In production, set these in Netlify → Site configuration → Environment variables.

# Optional: enables federal jobs from USAJOBS in /i-need-a-job.
# Request a free key at https://developer.usajobs.gov/apirequest/ ; USAJOBS_EMAIL must be the email you used.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
